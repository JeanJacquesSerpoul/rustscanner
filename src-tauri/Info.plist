<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- fusionné par Tauri dans le bundle macOS : sans ces clés, macOS refuse
     l'accès au réseau local et les scanners réseau restent invisibles -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>fr</string>
  </array>
  <key>NSLocalNetworkUsageDescription</key>
  <string>RustScanner looks for scanners on your local network (eSCL, AirScan, saned).</string>
  <key>NSBonjourServices</key>
  <array>
    <string>_uscan._tcp</string>
    <string>_uscans._tcp</string>
    <string>_scanner._tcp</string>
    <string>_sane-port._tcp</string>
  </array>
</dict>
</plist>
