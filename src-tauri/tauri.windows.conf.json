{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["nsis", "msi"],
    "publisher": "Jean-Jacques Serpoul",
    "longDescription": "Application de numérisation de documents pour Windows (WIA), inspirée de Skanpage : numérisation multipage, chargeur de documents, aperçu et zone de numérisation, export PDF et images, impression. Interface en français et en anglais.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "RustScanner"
      },
      "wix": {
        "language": ["fr-FR", "en-US"]
      }
    }
  }
}
