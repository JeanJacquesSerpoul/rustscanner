{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustScanner",
  "mainBinaryName": "rustscanner",
  "version": "0.1.0",
  "identifier": "fr.rustscanner.app",
  "build": {
    "beforeDevCommand": "trunk serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "trunk build --release",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RustScanner",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: scan: http://scan.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "GraphicsAndDesign",
    "shortDescription": "Numérisation de documents",
    "longDescription": "Application de numérisation de documents pour Linux (SANE), inspirée de Skanpage : numérisation multipage, chargeur de documents, aperçu et zone de numérisation, export PDF et images. Interface en français et en anglais.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "license": "MIT",
    "copyright": "Copyright (c) 2026 Jean-Jacques Serpoul",
    "linux": {
      "deb": {
        "depends": ["libsane1"]
      }
    }
  }
}
